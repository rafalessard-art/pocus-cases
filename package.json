{
  "name": "pocus-cases",
  "private": true,
  "type": "module",
  "description": "POCUS Learning Case Series — static teaching site + learner/faculty portal (/app).",
  "scripts": {
    "dev": "vite --config portal/vite.config.ts",
    "build": "node scripts/build-site.mjs",
    "typecheck": "tsc -p portal/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run portal/src",
    "test:db": "vitest run tests/db",
    "test:e2e": "playwright test",
    "visual": "node scripts/visual-report.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.56.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pg": "^8.13.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.4"
  }
}
